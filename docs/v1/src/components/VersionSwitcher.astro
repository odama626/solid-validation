---
import versions from '../../../versions.json';

const { current, versions: all } = versions;
const here = 'v1';
---

<label class="version-switcher">
  <span class="sr-only">Documentation version</span>
  <select onchange="if (this.value) window.location.href = this.value">
    {
      all.map(v => (
        <option value={v.path} selected={v.id === here}>
          {v.label}
          {v.id === current ? ' \u00b7 current' : ''}
        </option>
      ))
    }
  </select>
</label>

<style>
  .version-switcher select {
    margin: 0;
    padding-block: 0.3rem;
    font-size: 0.875rem;
    width: auto;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
